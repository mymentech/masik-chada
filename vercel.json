{
  "version": 2,
  "name": "masik_chada",
  "build": {
    "env": {
      "NODE_VERSION": "20"
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "echo 'deps installed per sub-project'",
  "functions": {
    "api/index.js": {
      "runtime": "nodejs20.x",
      "includeFiles": "backend/dist/**",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/graphql",       "destination": "/api/index.js" },
    { "source": "/health/:path*", "destination": "/api/index.js" },
    { "source": "/:path*",        "destination": "/index.html" }
  ]
}
